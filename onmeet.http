@baseUrl = http://localhost:8080
@companyId = YOUR_COMPANY_ID
@companyDomain = example.com
@inviterUserId = YOUR_INVITER_USER_ID
@inviteToken = YOUR_INVITE_TOKEN
@departmentId = YOUR_DEPARTMENT_ID
@positionId = YOUR_POSITION_ID

### Company email verification request (대표자email + 회사정보)
POST {{baseUrl}}/api/v1/auth/signup/company/email-verifications
Content-Type: application/json

{
  "representativeEmail": "ceo@example.com",
  "companyName": "OnMeet Co",
  "domain": "example.com",
  "companySize": "SMALL"
}

### Company email verification confirm
POST {{baseUrl}}/api/v1/auth/signup/company/email-verifications/confirm
Content-Type: application/json

{
  "token": "YOUR_EMAIL_VERIFICATION_TOKEN"
}

### Company signup (대표자email + pw + companyname + domain + verificationToken)
POST {{baseUrl}}/api/v1/auth/signup/company
Content-Type: application/json

{
  "representativeEmail": "ceo@example.com",
  "representativeName": "대표자",
  "password": "ChangeMe123!",
  "companyName": "OnMeet Co",
  "domain": "example.com",
  "verificationToken": "YOUR_EMAIL_VERIFICATION_TOKEN",
  "employeeNo": "CEO-001"
}

### Department create
POST {{baseUrl}}/api/v1/companies/{{companyId}}/departments
Content-Type: application/json

{
  "name": "Product"
}

### Position create
POST {{baseUrl}}/api/v1/companies/{{companyId}}/positions
Content-Type: application/json

{
  "name": "Manager"
}

### Team create
POST {{baseUrl}}/api/v1/teams
Content-Type: application/json

{
  "companyId": "{{companyId}}",
  "name": "Platform Team"
}

### Company login
POST {{baseUrl}}/api/v1/auth/login/company
Content-Type: application/json

{
  "email": "ceo@example.com",
  "password": "ChangeMe123!",
  "companyDomain": "example.com"
}

### Employee signup (direct, no invite)
POST {{baseUrl}}/api/v1/auth/signup/employee
Content-Type: application/json

{
  "email": "staff1@example.com",
  "password": "ChangeMe123!",
  "name": "Staff One",
  "companyId": "{{companyId}}",
  "employeeNo": "EMP-001",
  "departmentId": "{{departmentId}}",
  "positionId": "{{positionId}}"
}

### Employee login
POST {{baseUrl}}/api/v1/auth/login/employee
Content-Type: application/json

{
  "email": "staff1@example.com",
  "password": "ChangeMe123!",
  "companyId": "{{companyId}}"
}

### Create employee invite (MASTER/ADMIN only)
POST {{baseUrl}}/api/v1/auth/invites/employee
Content-Type: application/json

{
  "companyId": "{{companyId}}",
  "inviterUserId": "{{inviterUserId}}",
  "email": "invitee@example.com",
  "role": "MEMBER",
  "employeeNo": "EMP-002",
  "departmentId": "{{departmentId}}",
  "positionId": "{{positionId}}"
}

### Invite-based employee signup
POST {{baseUrl}}/api/v1/auth/signup/employee/invite
Content-Type: application/json

{
  "token": "{{inviteToken}}",
  "email": "invitee@example.com",
  "name": "Invited User",
  "employeeNo": "EMP-002",
  "role": "MEMBER",
  "password": "ChangeMe123!",
  "departmentId": "{{departmentId}}",
  "positionId": "{{positionId}}"
}
