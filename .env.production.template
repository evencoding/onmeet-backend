# Onmeet Backend - Production Environment Configuration Template
# 이 파일을 GCP 운영 서버의 프로젝트 루트에 .env로 복사하여 사용하세요.

# ===========================
# Docker Registry Configuration
# ===========================
# GitHub Actions에서 빌드한 이미지를 pull하기 위한 Docker Hub 사용자명
DOCKER_REGISTRY=your-dockerhub-username

# ===========================
# Database Configuration
# ===========================
DB_USERNAME=root
DB_ROOT_PASSWORD=your-secure-db-password

# Auth Service Database
AUTH_DB_URL=jdbc:mysql://mysql-auth:3306/auth_db?useSSL=false&allowPublicKeyRetrieval=true&characterEncoding=UTF-8&serverTimezone=UTC

# Redis Configuration
AUTH_REDIS_HOST=redis-auth

# ===========================
# Service Ports
# ===========================
AUTH_SERVICE_PORT=8081
GATEWAY_SERVICE_PORT=8080
AI_SERVICE_PORT=8082
VIDEO_SERVICE_PORT=8083
CHAT_SERVICE_PORT=8084
NOTIFICATION_SERVICE_PORT=8085
FILE_SERVICE_PORT=8087
EMAIL_SERVICE_PORT=8088

# ===========================
# Security Configuration
# ===========================
# Gateway와 각 서비스 간 통신용 공유 비밀키 (최소 32자 이상 권장)
GATEWAY_SHARED_SECRET=your-gateway-shared-secret-min-32-chars

# Auth Service 암호화 키 (32자)
AUTH_ENCRYPTION_KEY=your-32-char-encryption-key-here

# 탈퇴 회원 개인정보 AES 암호화 키 (정확히 16자 또는 32자)
# 주의: 한번 설정 후 변경하면 기존 암호화 데이터 복호화 불가
PRIVACY_ENCRYPTION_KEY=your-16-char-privacy-key

# ===========================
# Kafka Configuration
# ===========================
KAFKA_BOOTSTRAP_SERVERS=kafka:29092
KAFKA_BROKERS=kafka:29092

# ===========================
# AWS Configuration (File Service)
# ===========================
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_REGION=ap-northeast-2
S3_BUCKET_NAME=your-s3-bucket-name
CLOUDFRONT_DOMAIN=your-cloudfront-domain.cloudfront.net

# ===========================
# Email Service (AWS SES)
# ===========================
# AWS_ACCESS_KEY_ID와 AWS_SECRET_ACCESS_KEY를 재사용
# 또는 별도 IAM 사용자 생성 시 여기에 추가

# ===========================
# AI Service Configuration
# ===========================
ANTHROPIC_API_KEY=your-anthropic-api-key

# ===========================
# Email Service (Gmail OAuth2)
# ===========================
SPRING_MAIL_USERNAME=your-gmail-address@gmail.com
SPRING_MAIL_PASSWORD=your-mail-password
GMAIL_CLIENT_ID=your-gmail-client-id
GMAIL_CLIENT_SECRET=your-gmail-client-secret
GMAIL_REFRESH_TOKEN=your-gmail-refresh-token

# ===========================
# Notification Service (Firebase)
# ===========================
FIREBASE_CREDENTIALS_JSON=your-firebase-credentials-json

# ===========================
# Video Service Configuration
# ===========================
# LiveKit/Kafka 실제 구현체 활성화 (false면 NoOp 사용)
LIVEKIT_ENABLED=true
KAFKA_ENABLED=true

# WebRTC 관련 설정 (필요 시 추가)
# TURN_SERVER_URL=turn:your-turn-server.com:3478
# TURN_USERNAME=your-turn-username
# TURN_CREDENTIAL=your-turn-credential

# ===========================
# Monitoring & Logging
# ===========================
# 로그 레벨 (DEBUG, INFO, WARN, ERROR)
LOG_LEVEL=INFO

# ===========================
# Notes
# ===========================
# 1. 이 파일을 .env로 이름 변경 후 사용하세요
# 2. 모든 your-* 플레이스홀더를 실제 값으로 교체하세요
# 3. 비밀키는 절대 Git에 커밋하지 마세요
# 4. 프로덕션 환경에서는 강력한 비밀번호를 사용하세요
