# Shared Secrets
GATEWAY_SHARED_SECRET=your_strong_secret_here
AUTH_ENCRYPTION_KEY=your_32_char_encryption_key_here

# Database Credentials
DB_ROOT_PASSWORD=your_db_password_here
DB_USERNAME=your_db_username_here

# AWS Credentials (for email-service)
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=ap-northeast-2

# Spring Mail (for email-service)
SPRING_MAIL_HOST=your_mail_host
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=your_mail_username
SPRING_MAIL_PASSWORD=your_mail_password
EMAIL_FROM=noreply@onmeet.com

# Gmail OAuth2 (for email-service)
GMAIL_CLIENT_ID=your_gmail_client_id
GMAIL_CLIENT_SECRET=your_gmail_client_secret
GMAIL_REFRESH_TOKEN=your_gmail_refresh_token

# Firebase (for notification-service)
FIREBASE_CREDENTIALS_JSON=your_firebase_credentials_json

# LiveKit (for video-service)
LIVEKIT_ENABLED=true
LIVEKIT_URL=wss://livekit.onmeet.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# AI Service
OPENAI_API_KEY=your_openai_api_key
ANTHROPIC_API_KEY=your_anthropic_api_key

# Kafka Event Publishing (for video-service)
KAFKA_ENABLED=true

# Nginx / Domain
API_DOMAIN=api.onmeet.cloud
LIVEKIT_DOMAIN=livekit.onmeet.cloud
